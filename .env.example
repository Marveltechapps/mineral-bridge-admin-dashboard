# Copy to .env.local (gitignored). The Vite dev server reads this file.
# These names are not prefixed with VITE_, so they are not included in the browser bundle.
# The browser calls /v2, /admin, and /api on the dashboard origin. Vite proxies them.
#
# Mineral Bridge API origin. Default when this file is absent: http://127.0.0.1:5001
# Use the IPv4 loopback address. On Windows, "localhost" can be ::1 while the API
# listens on 0.0.0.0 (IPv4 only) and a different program can own that IPv6 port.
API_BASE_URL=http://127.0.0.1:5001

# Optional. Used only when API_BASE_URL is unset. The dev server still probes
# 127.0.0.1 and ::1 on this port and proxies only to a Mineral Bridge API.
# API_PORT=5001

# Optional older names. API_BASE_URL wins when more than one is set.
# A non-loopback value is used as given and is not replaced with this machine.
# API_PROXY_TARGET=http://10.0.0.2:5001
# VITE_API_URL=http://10.0.0.2:5001
