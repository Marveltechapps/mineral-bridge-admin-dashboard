# Copy to .env.local (gitignored). These are read only by the Vite dev server.
# They are not prefixed with VITE_, so they are not included in the browser bundle.
#
# Port of the Mineral Bridge API on this machine. The dev server probes
# 127.0.0.1 and ::1 and proxies only to the process that answers as Mineral Bridge.
API_PORT=5001

# Optional. Set this when the API is on another machine. Do not use localhost here:
# on some systems that name is IPv6 and can reach a different application.
# API_PROXY_TARGET=http://10.0.0.2:5001
